<script>

"use strict";

/* ==============================
   SIMULATION STATE
============================== */

const NORMAL_TEMP = 4.2;
const NORMAL_HUM = 54.2;
const NORMAL_VOLT = 3.284;

const MIN_TEMP = 2.0;
const MAX_TEMP = 8.0;

let currentTemp = NORMAL_TEMP;
let currentHum = NORMAL_HUM;
let currentVolt = NORMAL_VOLT;

let tempHistory = Array(30).fill(NORMAL_TEMP);

let isExecutingBreach = false;


/* ==============================
   DOM ELEMENTS
============================== */

const tempVal = document.getElementById("tempVal");
const humVal = document.getElementById("humVal");
const voltVal = document.getElementById("voltVal");

const terminal = document.getElementById("terminal");
const jsonPreview = document.getElementById("jsonPreview");

const canvas = document.getElementById("tempChart");
const ctx = canvas.getContext("2d");


/* ==============================
   CANVAS
============================== */

function resizeCanvas() {

  const rect = canvas.getBoundingClientRect();

  const dpr = window.devicePixelRatio || 1;

  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  drawChart();
}


/* ==============================
   LOGGING
============================== */

function log(msg, type = "") {

  const time = new Date().toLocaleTimeString();

  const line = document.createElement("div");

  if (type) {
    line.className = type;
  }

  line.textContent = `[${time}] ${msg}`;

  terminal.appendChild(line);

  terminal.scrollTop = terminal.scrollHeight;
}


/* ==============================
   TEMPERATURE CHART
============================== */

function drawChart() {

  const width = canvas.clientWidth;
  const height = canvas.clientHeight;

  if (!width || !height) {
    return;
  }

  ctx.clearRect(0, 0, width, height);

  /* Upper limit line = 8°C */

  ctx.beginPath();

  ctx.strokeStyle = "#263346";

  ctx.setLineDash([2, 2]);

  const limitY =
    height - (height * (MAX_TEMP / 15));

  ctx.moveTo(0, limitY);
  ctx.lineTo(width, limitY);

  ctx.stroke();

  ctx.setLineDash([]);


  /* Temperature line */

  ctx.beginPath();

  ctx.strokeStyle =
    (currentTemp > MAX_TEMP || currentTemp < MIN_TEMP)
      ? "#ef4444"
      : "#22c55e";

  ctx.lineWidth = 2;


  for (let i = 0; i < tempHistory.length; i++) {

    const x =
      i * (width / (tempHistory.length - 1));

    /* Keep chart inside 0–15°C range */

    const plottedTemp =
      Math.max(0, Math.min(15, tempHistory[i]));

    const y =
      height - (height * (plottedTemp / 15));


    if (i === 0) {
      ctx.moveTo(x, y);
    } else {
      ctx.lineTo(x, y);
    }

  }

  ctx.stroke();
}


/* ==============================
   UPDATE SENSOR DISPLAY
============================== */

function updateDisplay() {

  tempVal.innerText =
    `${currentTemp.toFixed(2)} °C`;

  humVal.innerText =
    `${currentHum.toFixed(1)} %`;

  voltVal.innerText =
    `${currentVolt.toFixed(3)} V`;

  if (
    currentTemp > MAX_TEMP ||
    currentTemp < MIN_TEMP
  ) {
    tempVal.className = "sensor-value alert";
  } else {
    tempVal.className = "sensor-value";
  }
}


/* ==============================
   1 Hz TELEMETRY ENGINE
============================== */

setInterval(() => {

  if (!isExecutingBreach) {

    /* Thermal noise */

    const noise =
      (Math.random() - 0.48) * 0.15;

    /* Slowly return temperature toward 4°C */

    currentTemp -=
      (currentTemp - 4.0) * 0.02;

    currentTemp += noise;


    /* Humidity noise */

    currentHum +=
      (Math.random() - 0.5) * 0.2;

    currentHum =
      Math.max(45, Math.min(65, currentHum));


    /* Supercapacitor voltage */

    currentVolt +=
      (Math.random() - 0.2) * 0.001;

    currentVolt =
      Math.max(3.20, Math.min(3.40, currentVolt));

  }


  updateDisplay();


  /* Update history */

  tempHistory.push(currentTemp);

  tempHistory.shift();

  drawChart();


  /* Automatic thermal breach */

  if (
    (currentTemp > MAX_TEMP ||
     currentTemp < MIN_TEMP) &&
    !isExecutingBreach
  ) {

    triggerHardwareBreach(currentTemp);

  }

}, 1000);


/* ==============================
   HARDWARE BREACH SEQUENCE
============================== */

function triggerHardwareBreach(temp) {

  if (isExecutingBreach) {
    return;
  }

  isExecutingBreach = true;

  const isNetLost =
    document.getElementById("netLossToggle").checked;


  log(
    `[ALERT] Temperature exceeded threshold (${temp.toFixed(2)}°C)!`,
    "t-alert"
  );


  /* --------------------------------
     STEP 1 — CRYPTO
  -------------------------------- */

  setTimeout(() => {

    document.getElementById("dot-crypto")
      .className = "status-dot purple";

    document.getElementById("box-crypto")
      .classList.add("active");

    log(
      "[ATECC608A] Generating ECDSA SECP256R1 Hardware Signature...",
      "t-crypto"
    );

  }, 500);


  /* --------------------------------
     STEP 2 — POWER GATE
  -------------------------------- */

  setTimeout(() => {

    document.getElementById("dot-mosfet")
      .className = "status-dot red";

    document.getElementById("box-mosfet")
      .className = "component-box power-on";

    document.getElementById("mosfetText")
      .innerText =
      "Gate Pin: PA4 (LOW - MOSFET Conducting)";

    log(
      "[POWER GATE] AO3401A P-MOSFET Switch CLOSED - Powering SIM7080G",
      "t-power"
    );

  }, 1200);


  /* --------------------------------
     STEP 3 — MODEM + AWS PAYLOAD
  -------------------------------- */

  setTimeout(() => {

    document.getElementById("dot-modem")
      .className = "status-dot yellow";

    document.getElementById("box-modem")
      .classList.add("active");

    document.getElementById("modemText")
      .innerText =
      "State: ACTIVE TRANSMISSION (220 mA)";


    log(
      "[SIM7080G] Booting Cellular Modem..."
    );


    /*
      NOTE:
      This is a simulated ECDSA signature
      for the Digital Twin demonstration.
      It is NOT a real cryptographic signature.
    */

    const simulatedSignature =
      "0x30440220" +
      Math.random()
        .toString(16)
        .slice(2, 10)
        .toUpperCase();


    const payload = {

      node_id:
        "SIH_COLDCHAIN_01",

      temp_celsius:
        Number(temp.toFixed(2)),

      humidity_pct:
        Number(currentHum.toFixed(1)),

      ecdsa_signature:
        simulatedSignature,

      network_state:
        isNetLost
          ? "OFFLINE_SAVED"
          : "TRANSMITTED_LIVE"

    };


    jsonPreview.innerText =
      JSON.stringify(payload, null, 2);


    /* --------------------------------
       NETWORK AVAILABLE
    -------------------------------- */

    if (!isNetLost) {

      log(
        '[SIM7080G] AT+SMPUB="coldchain/breach",1,1,"{...}"',
        "t-cloud"
      );

      log(
        "[AWS IoT] MQTT Publish CONFIRMED by Cloud!",
        "t-cloud"
      );

    }


    /* --------------------------------
       NETWORK LOST
    -------------------------------- */

    else {

      log(
        "[SIM7080G] No Cellular Carrier Signal! Routing to EEPROM...",
        "t-alert"
      );

      log(
        "[STORAGE] Telemetry buffered locally at EEPROM address 0x50"
      );

    }


    powerDownSequence();

  }, 2200);

}


/* ==============================
   POWER DOWN
============================== */

function powerDownSequence() {

  setTimeout(() => {

    /* Reset status LEDs */

    document.getElementById("dot-crypto")
      .className = "status-dot";

    document.getElementById("dot-mosfet")
      .className = "status-dot";

    document.getElementById("dot-modem")
      .className = "status-dot";


    /* Reset component boxes */

    document.getElementById("box-crypto")
      .className = "component-box";

    document.getElementById("box-mosfet")
      .className = "component-box";

    document.getElementById("box-modem")
      .className = "component-box";


    /* Restore hardware state */

    document.getElementById("mosfetText")
      .innerText =
      "Gate Pin: PA4 (HIGH - Modem OFF)";

    document.getElementById("modemText")
      .innerText =
      "State: POWERED DOWN (0 mA)";


    log(
      "[POWER GATE] MOSFET Opened. SIM7080G Powered DOWN",
      "t-power"
    );

    log(
      "[SYSTEM] STM32 Re-entering STOP Mode"
    );


    /* Return to normal temperature */

    currentTemp = NORMAL_TEMP;

    currentHum = NORMAL_HUM;

    currentVolt = NORMAL_VOLT;

    tempHistory =
      Array(30).fill(NORMAL_TEMP);


    isExecutingBreach = false;

    updateDisplay();

    drawChart();


    jsonPreview.innerText =
`{
  "status": "WAITING_FOR_BREACH"
}`;


  }, 2000);

}


/* ==============================
   MANUAL THERMAL SPIKE
============================== */

document.getElementById("spikeBtn")
  .addEventListener("click", () => {

    if (isExecutingBreach) {
      return;
    }

    currentTemp = 11.5;

    updateDisplay();

    drawChart();

  });


/* ==============================
   RESET DEMO
============================== */

document.getElementById("resetBtn")
  .addEventListener("click", () => {

    isExecutingBreach = false;

    currentTemp = NORMAL_TEMP;

    currentHum = NORMAL_HUM;

    currentVolt = NORMAL_VOLT;

    tempHistory =
      Array(30).fill(NORMAL_TEMP);


    /* Reset hardware */

    document.getElementById("dot-crypto")
      .className = "status-dot";

    document.getElementById("dot-mosfet")
      .className = "status-dot";

    document.getElementById("dot-modem")
      .className = "status-dot";


    document.getElementById("box-crypto")
      .className = "component-box";

    document.getElementById("box-mosfet")
      .className = "component-box";

    document.getElementById("box-modem")
      .className = "component-box";


    document.getElementById("mosfetText")
      .innerText =
      "Gate Pin: PA4 (HIGH - Modem OFF)";

    document.getElementById("modemText")
      .innerText =
      "State: POWERED DOWN (0 mA)";


    jsonPreview.innerText =
`{
  "status": "WAITING_FOR_BREACH"
}`;


    updateDisplay();

    drawChart();

    log(
      "[SYSTEM] Digital Twin manually reset."
    );

  });


/* ==============================
   INITIALIZATION
============================== */

window.addEventListener(
  "resize",
  resizeCanvas
);

resizeCanvas();

updateDisplay();

log(
  "[SYSTEM] Real-Time Hardware Twin Active. 1 Hz Sensor Sampling..."
);

</script>

</body>
</html>
