<body>

<header>
  <h1>SIH Cold Chain — Real-Time Dynamic Telemetry Digital Twin</h1>
  <span class="badge">LIVE FEED: 1 Hz SAMPLING</span>
</header>

<div class="grid">

  <!-- SENSOR MONITORING PANEL -->
  <div class="card">

    <h2>Real-Time Sensor Fluctuations</h2>

    <div class="sensor-card">

      <div class="sensor-title">
        <span>SHT31 Temperature</span>
        <span>Target: 2.0°C - 8.0°C</span>
      </div>

      <div id="tempVal" class="sensor-value">
        4.20 °C
      </div>

      <canvas id="tempChart"></canvas>

    </div>

    <div class="sensor-card">

      <div class="sensor-title">
        <span>SHT31 Humidity / Moisture</span>
        <span>Limit: 85.0%</span>
      </div>

